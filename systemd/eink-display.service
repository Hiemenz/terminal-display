[Unit]
Description=E-ink Display (terminal or stats dashboard)
After=network.target graphical-session.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/git/terminal-display

# Reads startup_mode from config and launches the right script.
ExecStart=/home/pi/git/terminal-display/systemd/launcher.sh

# Restart on crash, but not on clean exit (e.g. mode-switch spawns new process)
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# terminal_use_tmux spawns tmux (and whatever's running inside it, e.g. a
# `claude` session) as a child of this service. Default KillMode=control-group
# would SIGTERM/SIGKILL the whole cgroup on every restart/stop, killing tmux
# and everything in it even though tmux would otherwise survive its parent
# dying. KillMode=process signals only the tracked main PID (the python
# process; launcher.sh execs it), leaving tmux and its sessions running so
# the next start's `tmux new-session -A` just reattaches.
KillMode=process

# Health watchdog: the app pings WATCHDOG=1 from its main loop (src/sd_watchdog.py).
# If the loop hangs and stops pinging for this long, systemd restarts the
# service. A busy-spin would keep pinging, so sd_watchdog also detects a spinning
# loop and deliberately withholds pings so the watchdog still fires.
WatchdogSec=60

# Resource caps: keep a runaway from taking down the whole Pi. With KillMode=process
# and terminal_use_tmux, tmux and everything inside it (including any `claude`
# sessions) stay in this cgroup across restarts, so the cap has to cover all of
# that too, not just the ~100M steady-state app itself.
MemoryMax=2G
CPUQuota=200%

# Ensure SPI, GPIO, and raw keyboard input are accessible (Pi-specific)
SupplementaryGroups=spi gpio video input

[Install]
WantedBy=multi-user.target
